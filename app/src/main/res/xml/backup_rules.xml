<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and older: nothing of this app is uploaded to Google Drive backups. Songs, takes and
  settings stay on the device (spec: no cloud).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
